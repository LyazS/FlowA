{
  "Provider": "Exam Provider",
  "Label": "示例供应商",
  "Version": "1.0.0",
  "Description": "Exam plugin for FlowA",
  "Author": "FlowA Team",
  "Icon": "exam.png",
  "ProviderSetting": { "Execute": "exam_provider_setting.py" },
  "Plugins": [
    {
      "Type": "FANode",
      "Name": "@/Exam Provider/ExamNode",
      "Label": "示例节点",
      "Description": "Example node for FlowA",
      "Execute": "examnode.py",
      "Setting": { "Execute": "examnode_setting.py" }
    },
    {
      "Type": "FANode",
      "Name": "@/Exam Provider/ExamNestNode",
      "Label": "示例嵌套节点",
      "Description": "Example nest node for FlowA",
      "Execute": "exam_nest_node.py",
      "Setting": { "Execute": "examnode_setting.py" }
    }
  ],
  "UIPlugins": [
    {
      "Type": "FANode",
      "Name": "@/Exam Provider/UI_TEXT_INPUT",
      "Component": "examui.py"
    }
  ]
}
